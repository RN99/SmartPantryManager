<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/pretty_background">

    <!-- Recipe Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:elevation="6dp"
        app:cardCornerRadius="12dp"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/pretty_background"
            android:padding="12dp">

            <!-- Recipe Name -->
            <TextView
                android:id="@+id/textRecipeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="Recipe Name"
                android:textColor="@color/textPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Pantry icon -->
            <ImageView
                android:id="@+id/imagePantryIcon"
                android:layout_width="75dp"
                android:layout_height="62dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Pantry Icon"
                android:src="@drawable/pantry" />

            <!-- Recipe Steps -->
            <TextView
                android:id="@+id/textRecipeSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Steps"
                android:textColor="@color/textSecondary"
                android:textSize="16sp" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="8dp">

                <!-- Edit button with text below -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageButton
                        android:id="@+id/buttonEdit"
                        android:layout_width="58dp"
                        android:layout_height="61dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Edit recipe"
                        android:src="@drawable/edit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textColor="@color/textSecondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Delete button with text below -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <ImageButton
                        android:id="@+id/buttonDelete"
                        android:layout_width="58dp"
                        android:layout_height="61dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Delete recipe"
                        android:src="@drawable/delete" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete"
                        android:textColor="@color/textSecondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
