<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    android:background="@drawable/pretty_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Toolbar at the very top -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/pretty_background"
        app:title="Smart Pantry Manager"
        app:titleTextColor="#333333"
        android:gravity="center"
        android:textStyle="bold"/>

    <!-- Title centered at top -->
    <TextView
        android:id="@+id/textPantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:paddingBottom="8dp"/>

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:layout_gravity="center"
        android:contentDescription="App Logo"
        android:paddingBottom="16dp"/>

    <!-- Empty pantry message -->
    <TextView
        android:id="@+id/emptyPantryMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Add ingredients!"
        android:gravity="center"
        android:visibility="gone"
        android:textColor="@color/textSecondary"
        android:padding="16dp"/>


    <!-- Pantry items list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"/>

    <!-- Icon -->

    <ImageView
        android:id="@+id/imageAddIngredient"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="Add Ingredient"
        android:src="@drawable/add" />

    <!-- Text below icon -->

    <TextView
        android:id="@+id/textAddIngredient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:layout_gravity="center"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:paddingTop="4dp"/>

    <!-- Recipe navigation icon -->
    <ImageView
        android:id="@+id/imageViewRecipes"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:contentDescription="View Recipes"
        android:src="@drawable/pantry" />

    <!-- Text below icon -->
    <TextView
        android:id="@+id/textViewRecipes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View Recipes"
        android:layout_gravity="center"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:paddingTop="4dp"/>


</LinearLayout>
